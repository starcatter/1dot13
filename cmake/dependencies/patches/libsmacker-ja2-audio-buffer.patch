+/* Some fan-localized JA2 intro SMKs understate the header's maximum decoded
+	audio size. Grow for the per-frame size, bounded by a decoded-chunk policy. */
+static char smk_audio_fit_buffer(struct smk_audio_t * s, unsigned long required_size)
+{
+	void * grown;
+
+	if (required_size > 0x1000000UL) {
+		fputs("libsmacker::smk_audio_fit_buffer() - ERROR: implausibly large audio chunk.\n", stderr);
+		return -1;
+	}
+
+	if (required_size <= (unsigned long)s->max_buffer)
+		return 0;
+
+	if ((grown = realloc(s->buffer, required_size)) == NULL) {
+		perror("libsmacker::smk_audio_fit_buffer() - ERROR: failed to grow audio buffer");
+		return -1;
+	}
+
+	s->buffer = grown;
+	s->max_buffer = required_size;
+	return 0;
+}
